# ============================================================
# TORA HOUSE — EXAMPLE ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to git.
# ============================================================

# ─── Supabase (Optional Cloud Database) ─────────────────────
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Official WhatsApp Contact (Displayed on Website) ───────
VITE_WHATSAPP_NUMBER=966579165664

# ─── Admin Session Security ─────────────────────────────────
# Any long random string for signing admin session tokens
ADMIN_SESSION_SECRET=your_admin_jwt_secret_key_here

# ─── Meta WhatsApp Business Cloud API ───────────────────────
# Get these free from https://developers.facebook.com/
META_WHATSAPP_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here

# Owner phone number to receive order notifications (digits only)
OWNER_WHATSAPP_DESTINATION=966579165664

# ─── Server Port ────────────────────────────────────────────
PORT=5173
NODE_ENV=development
